datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  address       String?
  role          String         @default("CUSTOMER") // "CUSTOMER", "ADMIN"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  notifications Notification[]
}

model Category {
  id        String    @id @default(uuid())
  nameEn    String
  nameTh    String
  nameLa    String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String      @id @default(uuid())
  nameEn        String
  nameTh        String
  nameLa        String
  descriptionEn String
  descriptionTh String
  descriptionLa String
  price         Float
  stock         Int
  images        String // Store JSON string array of URLs
  isBestSeller  Boolean     @default(false)
  isNewArrival  Boolean     @default(false)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  orderNumber     String      @unique
  totalAmount     Float
  status          String      @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PREPARING, SHIPPING, DELIVERED, CANCELLED
  paymentMethod   String      // STRIPE, PAYPAL, QR_CODE
  paymentStatus   String      @default("PENDING") // PENDING, PAID, FAILED
  shippingAddress String
  trackingNumber  String?
  slipUrl         String?     // Bank transfer receipt image URL
  shippingSlipUrl String?     // Courier shipping slip receipt image URL
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  titleEn   String
  titleTh   String
  titleLa   String
  messageEn String
  messageTh String
  messageLa String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
